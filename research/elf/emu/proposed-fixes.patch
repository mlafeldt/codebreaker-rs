+// Modular exponentiation as CodeBreaker computes it for RSA decryption:
+// square-and-multiply on top of its bignum library, whose reduction doesn't
+// clamp the quotient digit estimate to 2^32 - 1 (Knuth D3). The result is
+// wrong (but deterministic) whenever a partial remainder's top word is
+// 0xffffffff, e.g. for every base in 0xffffffff80000000..modulus.
+fn cb_mod_pow(base: u64, exp: u64, modulus: u64) -> u64 {
+    let base = cb_mod(&mut [base as u32, (base >> 32) as u32, 0, 0, 0], modulus);
+    let mut result = base;
+    for bit in (0..63 - exp.leading_zeros()).rev() {
+        result = cb_mul_mod(result, result, modulus);
+        if exp >> bit & 1 == 1 {
+            result = cb_mul_mod(result, base, modulus);
+        }
+    }
+    result
+}
+
+fn cb_mul_mod(a: u64, b: u64, modulus: u64) -> u64 {
+    let p = u128::from(a) * u128::from(b);
+    cb_mod(&mut [p as u32, (p >> 32) as u32, (p >> 64) as u32, (p >> 96) as u32, 0], modulus)
+}
+
+// Reduces up to 4 words modulo a 64-bit modulus with a set top bit, and
+// returns the low 2 words of what's left (the firmware copies only those).
+fn cb_mod(r: &mut [u32; 5], modulus: u64) -> u64 {
+    const B96: u128 = 1 << 96;
+    let word = |r: &[u32; 5], i: usize| u64::from(r[i]) | u64::from(r[i + 1]) << 32;
+    let mut len = 4;
+    while len > 0 && r[len - 1] == 0 {
+        len -= 1;
+    }
+    if len >= 2 {
+        let v1 = modulus >> 32;
+        for u in (3..=len + 1).rev() {
+            let i = u - 2;
+            let w = word(r, i);
+            if w > modulus {
+                let d = w - modulus;
+                (r[i], r[i + 1]) = (d as u32, (d >> 32) as u32);
+            }
+            // Only the low word of the 64-bit quotient is used
+            let q = (word(r, i) / v1) as u32;
+            let t = u128::from(q) * u128::from(modulus);
+            let mut c = u128::from(r[i - 1]) | u128::from(word(r, i)) << 32;
+            if c >= t {
+                c -= t;
+            } else {
+                c = c + B96 - t + u128::from(modulus);
+                if c < B96 {
+                    c += u128::from(modulus);
+                }
+                c %= B96;
+            }
+            (r[i - 1], r[i], r[i + 1]) = (c as u32, (c >> 32) as u32, (c >> 64) as u32);
+        }
+        let w = word(r, 0);
+        if w > modulus {
+            let d = w - modulus;
+            (r[0], r[1]) = (d as u32, (d >> 32) as u32);
+        }
+    }
+    word(r, 0)
 }
 
